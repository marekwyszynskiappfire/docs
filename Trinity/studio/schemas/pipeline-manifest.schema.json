{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pipeline-manifest.schema.json",
  "title": "TrinityPipelineManifest",
  "description": "Portfolio entry artifact. References per-Epic review payloads by repository-relative path and content hash. Does not embed payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_id",
    "label",
    "product_id",
    "persona_id",
    "target_environment",
    "scope",
    "output_root",
    "generated_at",
    "epics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "pipeline_run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Filled after the first Studio import. Re-import reuses this run."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "product_id": {
      "type": "string",
      "minLength": 1
    },
    "persona_id": {
      "type": "string",
      "minLength": 1,
      "description": "Path under Trinity/personas/, e.g. reviewer-expert-qa-automation.md"
    },
    "target_environment": {
      "type": "string",
      "enum": ["sandbox", "production"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["filter_url", "jql", "epic_keys", "epic_url"]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+$",
      "description": "Repository-relative Reviewer run folder that contains one directory per Epic."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jira_key", "review_payload_path", "content_sha256"],
        "properties": {
          "jira_key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]+-\\d+$"
          },
          "review_payload_path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./-]+/review-payload\\.json$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
