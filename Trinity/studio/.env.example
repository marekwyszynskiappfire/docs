# Trinity Studio local secrets — copy to .env (gitignored). Never commit .env.
#
# Sandbox (appfire-sandbox-774): use these values when importing to sandbox in Importer.
# Production: swap to appfire.atlassian.net and production Xray API keys before Execute.

# Jira REST (Reviewer "Resolve from scope" + Importer requirement links)
JIRA_BASE_URL=https://appfire-sandbox-774.atlassian.net
JIRA_EMAIL=you@appfire.com
JIRA_API_TOKEN=

# Xray Cloud API keys (Jira → Apps → Xray → Settings → API Keys — for this Jira site)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
