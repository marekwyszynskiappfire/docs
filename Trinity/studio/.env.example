# Trinity Studio local secrets — copy to .env (gitignored). Never commit .env.
#
# Production (default in Studio Importer): appfire.atlassian.net + production Xray API keys.
# Sandbox: use https://appfire-sandbox-774.atlassian.net and sandbox Xray keys when you switch instance in Importer.

# Jira REST (Reviewer "Resolve from scope" + Importer requirement links)
JIRA_BASE_URL=https://appfire.atlassian.net
JIRA_EMAIL=you@appfire.com
JIRA_API_TOKEN=

# Xray Cloud API keys (Jira → Apps → Xray → Settings → API Keys — for this Jira site)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Optional telemetry (Studio works without these — see Trinity/METRICS.md)
# TRINITY_TELEMETRY_URL=
# TRINITY_TELEMETRY_API_KEY=
# TRINITY_OPERATOR_ID=

# Optional Cursor Team Admin API — backfill chargedCents per Agent conversation (Trinity/CURSOR-COST.md)
# CURSOR_ADMIN_API_KEY=
