# Trinity Studio local secrets — copy to .env (gitignored). Never commit .env.
#
# Production (default in Studio Importer): appfire.atlassian.net + production Xray API keys.
# Sandbox: use https://appfire-sandbox-774.atlassian.net and sandbox Xray keys when you switch instance in Importer.

# Jira REST (Reviewer "Resolve from scope" + Importer requirement links)
JIRA_BASE_URL=https://appfire.atlassian.net
JIRA_EMAIL=you@appfire.com
JIRA_API_TOKEN=

# Xray Cloud API keys (Jira → Apps → Xray → Settings → API Keys — for this Jira site)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# Optional BigQuery telemetry (full setup: Trinity/BIGQUERY.md)
# Human operator shown in analytics (not the GCP service account).
# TRINITY_OPERATOR_ID=you@appfire.com
# TRINITY_OPERATOR_NAME="Your Name"
#
# Local ingest target and absolute credential path:
# BQ_PROJECT=qa-coe
# BQ_DATASET=trinity
# GOOGLE_APPLICATION_CREDENTIALS=/Users/<mac-login>/.config/trinity/qa-coe-bigquery.json
#
# Leave URL/key unset for local ingest; start.sh supplies both automatically.
# For a shared hosted ingest set:
# TRINITY_TELEMETRY_URL=https://<host>/v1/events
# TRINITY_TELEMETRY_API_KEY=<shared-ingest-secret>

# Optional Cursor Team Admin API — backfill chargedCents per Agent conversation (Trinity/CURSOR-COST.md)
# CURSOR_ADMIN_API_KEY=
